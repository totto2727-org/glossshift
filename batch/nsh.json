{
  "name": "GlossShiftBatch",
  "id": "com.totto2727.glossshift.batch",
  "version": "0.2.0",
  "build": 1,
  "capabilities": {
    "fs": {
      "read": [],
      "write": []
    },
    "network": {
      "hosts": ["127.0.0.1", "huggingface.co", "*.huggingface.co", "*.hf.co"]
    },
    "process": {
      "exit": true,
      "execute": [],
      "env": [
        "TMPDIR",
        "XDG_CONFIG_HOME",
        "XDG_CACHE_HOME",
        "GLOSSSHIFT_CONFIG",
        "GLOSSSHIFT_LLAMA_SERVER",
        "GLOSSSHIFT_COREUTILS",
        "GLOSSSHIFT_CURL",
        "SSL_CERT_FILE",
        "GLOSSSHIFT_BATCH_ARGS",
        "GLOSSSHIFT_BATCH_CWD",
        "GLOSSSHIFT_BATCH_STDOUT",
        "GLOSSSHIFT_BATCH_STDOUT_IS_TTY",
        "GLOSSSHIFT_BATCH_STDERR",
        "GLOSSSHIFT_BATCH_STATUS"
      ]
    }
  }
}
