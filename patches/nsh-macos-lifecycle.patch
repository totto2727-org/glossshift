+/// Shows the retained standalone window. Safe to call from any thread.
+pub fn show_app() {
+    dispatch2::DispatchQueue::main().exec_async(|| {
+        let window = RUNNING.with(|r| r.borrow().as_ref().map(|r| r.window.clone()));
+        if let Some(window) = window {
+            if window.isMiniaturized() {
+                window.deminiaturize(None);
+            }
+            window.makeKeyAndOrderFront(None);
+            #[allow(
+                deprecated,
+                reason = "A user-invoked shortcut cannot depend on the foreground app yielding activation"
+            )]
+            NSApplication::sharedApplication(MainThreadMarker::from(&*window))
+                .activateIgnoringOtherApps(true);
+        }
+    });
+}
+
+/// Hides, but does not close or dispose, the standalone window.
+pub fn hide_app() {
+    dispatch2::DispatchQueue::main().exec_async(|| {
+        let window = RUNNING.with(|r| r.borrow().as_ref().map(|r| r.window.clone()));
+        if let Some(window) = window {
+            window.orderOut(None);
+        }
+    });
+}
