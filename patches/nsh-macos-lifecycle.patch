+/// Main-thread services owned by an app using the standalone runner.
+/// Installing hooks has no side effects, including in the describe/test hosts.
+#[derive(Clone, Copy)]
+pub struct StandaloneHooks {
+    /// Configure the window and start native services before it can activate.
+    /// `Ok(false)` exits successfully without opening a window.
+    pub setup: fn(&mut AppOptions) -> Result<bool, String>,
+    /// Release native services after the engine stops, including setup failure.
+    pub shutdown: fn(),
+}
+
+static STANDALONE_HOOKS: RwLock<Option<StandaloneHooks>> = RwLock::new(None);
+
+/// Installs one app's lifecycle hooks before calling [`run_app`].
+pub fn set_standalone_hooks(hooks: StandaloneHooks) {
+    *STANDALONE_HOOKS.write().unwrap_or_else(|e| e.into_inner()) = Some(hooks);
+}
+
+struct StandaloneGuard(Option<StandaloneHooks>);
+
+impl Drop for StandaloneGuard {
+    fn drop(&mut self) {
+        if let Some(hooks) = self.0 {
+            (hooks.shutdown)();
+        }
+    }
+}
