{
  shell,
  coreutils,
  jq,
  host,
  tuiBundle,
  batchBundle,
  capabilities,
  runtimeEnvironment,
}:

builtins.replaceStrings
  [
    "@shell@"
    "@runtimeEnvironment@"
    "@host@"
    "@tuiBundle@"
    "@batchBundle@"
    "@mktemp@"
    "@rm@"
    "@cat@"
    "@jq@"
    "@cp@"
    "@realpath@"
    "@capabilities@"
  ]
  [
    shell
    runtimeEnvironment
    host
    tuiBundle
    batchBundle
    "${coreutils}/bin/mktemp"
    "${coreutils}/bin/rm"
    "${coreutils}/bin/cat"
    "${jq}/bin/jq"
    "${coreutils}/bin/cp"
    "${coreutils}/bin/realpath"
    capabilities
  ]
  (builtins.readFile ../packaging/gshift-launcher.sh)
