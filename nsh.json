{
  "name": "GlossShift",
  "id": "com.totto2727.glossshift",
  "version": "0.2.0",
  "build": 1,
  "icon": "packaging/app-icon.png",
  "rust": "native",
  "capabilities": {
    "clipboard": true,
    "statusBar": true,
    "process": {
      "execute": ["node"],
      "env": ["XDG_CONFIG_HOME", "XDG_CACHE_HOME", "GLOSSSHIFT_CONFIG"]
    }
  }
}
