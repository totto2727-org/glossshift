{
  "name": "GlossShiftTerminal",
  "id": "com.totto2727.glossshift.terminal",
  "version": "0.2.0",
  "build": 1,
  "capabilities": {
    "clipboard": true,
    "fs": {
      "read": ["${homeDir}", "${dataDir}", "${pluginDir}", "/private/tmp", "/tmp"],
      "write": ["${homeDir}", "${dataDir}", "/private/tmp", "/tmp"]
    },
    "network": { "hosts": ["127.0.0.1"] },
    "process": {
      "execute": ["coreutils", "curl", "llama-server"],
      "env": [
        "XDG_CONFIG_HOME",
        "XDG_CACHE_HOME",
        "GLOSSSHIFT_CONFIG",
        "GLOSSSHIFT_COREUTILS",
        "GLOSSSHIFT_CURL",
        "GLOSSSHIFT_LLAMA_SERVER"
      ]
    }
  }
}
